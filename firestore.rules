
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Utility functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /chat_users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /friend_requests/{requestId} {
      allow read: if isSignedIn() && (isOwner(resource.data.from) || isOwner(resource.data.to));
      allow create: if isSignedIn() && isOwner(request.resource.data.from);
      allow update: if isSignedIn() && isOwner(resource.data.to);
      allow delete: if isSignedIn() && (isOwner(resource.data.from) || isOwner(resource.data.to));
    }

    match /chats/{chatId} {
      allow read, write: if isSignedIn() && (request.auth.uid in resource.data.participants || request.auth.uid in request.resource.data.participants);
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if isSignedIn() && isOwner(request.resource.data.senderId);
        allow delete: if isSignedIn() && isOwner(resource.data.senderId);
      }
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
