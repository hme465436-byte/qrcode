rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tempRooms/{id} {
      allow read, write: if true;
    }
    match /pages/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}