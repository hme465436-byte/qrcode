
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /temp_rooms/{id} {
      allow read, write: if true;
    }
    match /pages/{id} {
      // Pages are publicly readable and writable by anyone for instant hosting
      allow read, write: if true;
    }
    match /file_host_history/{id} {
      // Users can only manage their own history records
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.uid && request.resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
