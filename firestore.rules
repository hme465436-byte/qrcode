
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /temp_rooms/{id} {
      allow read, write: if true;
    }
    match /pages/{id} {
      // Pages are publicly readable by anyone with the link
      allow read: if true;
      // Allow any authenticated user (including anonymous guests) to create pages
      allow create: if request.auth != null;
      // Only allow the original creator to delete or update
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
