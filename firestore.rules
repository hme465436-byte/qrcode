
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Utility functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Chat Identity Matrix
    match /chat_users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /friend_requests/{requestId} {
      allow read: if isSignedIn() && (isOwner(resource.data.from) || isOwner(resource.data.to));
      allow create: if isSignedIn() && isOwner(request.resource.data.from);
      allow update: if isSignedIn() && isOwner(resource.data.to);
      allow delete: if isSignedIn() && (isOwner(resource.data.from) || isOwner(resource.data.to));
    }

    match /chats/{chatId} {
      // Separated read/write to avoid null reference on request.resource during read
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants);
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow delete: if isSignedIn() && (request.auth.uid in resource.data.participants);
      
      match /messages/{messageId} {
        // Use get() to verify parent chat participants for message stream
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }

    // Identity Registry History (Private)
    match /image_to_url_history/{docId} {
      allow read: if isSignedIn() && isOwner(resource.data.uid);
      allow create: if isSignedIn() && isOwner(request.resource.data.uid);
      allow update: if isSignedIn() && isOwner(resource.data.uid);
      allow delete: if isSignedIn() && isOwner(resource.data.uid);
    }
    match /file_host_history/{docId} {
      allow read: if isSignedIn() && isOwner(resource.data.uid);
      allow create: if isSignedIn() && isOwner(request.resource.data.uid);
      allow update: if isSignedIn() && isOwner(resource.data.uid);
      allow delete: if isSignedIn() && isOwner(resource.data.uid);
    }
    match /temp_upload_history/{docId} {
      allow read: if isSignedIn() && isOwner(resource.data.uid);
      allow create: if isSignedIn() && isOwner(request.resource.data.uid);
      allow update: if isSignedIn() && isOwner(resource.data.uid);
      allow delete: if isSignedIn() && isOwner(resource.data.uid);
    }

    // Shadow Chat (Ephemeral Nodes) - Public Access by Code
    match /rooms/{roomId} {
      allow read, write: if true;
      match /members/{memberId} {
        allow read, write: if true;
      }
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Default catch-all (Secure by default)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
