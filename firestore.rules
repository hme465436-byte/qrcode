
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /temp_rooms/{id} {
      allow read, write: if true;
    }
    match /pages/{id} {
      // Pages are publicly readable by anyone with the link
      allow read: if true;
      // Anyone can publish and manage pages
      allow write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
