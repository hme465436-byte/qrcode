
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /temp_rooms/{id} {
      allow read, write: if true;
    }
    match /pages/{id} {
      // Pages are publicly readable and writable by anyone for instant hosting
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
