{
  "entities": {
    "SignalingRoom": {
      "title": "Signaling Room",
      "description": "A temporary room for WebRTC signaling exchange.",
      "type": "object",
      "properties": {
        "offer": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "fileMeta": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "size": {
              "type": "number"
            },
            "type": {
              "type": "string"
            }
          }
        }
      }
    },
    "IceCandidate": {
      "title": "ICE Candidate",
      "description": "An ICE candidate for WebRTC connection.",
      "type": "object",
      "properties": {
        "candidate": {
          "type": "string"
        },
        "sdpMLineIndex": {
          "type": "number"
        },
        "sdpMid": {
          "type": "string"
        }
      }
    },
    "TempRoom": {
      "title": "Temp Room",
      "description": "A temporary room for live text synchronization.",
      "type": "object",
      "properties": {
        "peerId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "waiting",
            "connected"
          ]
        },
        "createdAt": {
          "type": "number"
        }
      }
    },
    "HostedPage": {
      "title": "Hosted Page",
      "description": "A static HTML page or code block hosted via URL.",
      "type": "object",
      "properties": {
        "html": {
          "type": "string",
          "description": "The code content of the page."
        },
        "title": {
          "type": "string",
          "description": "Title for the page."
        },
        "language": {
          "type": "string",
          "description": "The language protocol (html, python, etc)."
        },
        "uid": {
          "type": "string",
          "description": "The owner's unique identity token (optional for anonymous)."
        },
        "createdAt": {
          "type": "object",
          "description": "Firestore server timestamp."
        }
      },
      "required": [
        "html",
        "createdAt"
      ]
    },
    "FileHostHistory": {
      "title": "File Host History",
      "description": "Metadata for files hosted on external providers like Telegram.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user ID of the file owner."
        },
        "name": {
          "type": "string",
          "description": "Original filename."
        },
        "customName": {
          "type": "string",
          "description": "User-assigned label."
        },
        "size": {
          "type": "number",
          "description": "File size in bytes."
        },
        "mime": {
          "type": "string",
          "description": "MIME type of the file."
        },
        "fileId": {
          "type": "string",
          "description": "Provider-specific file identifier (e.g. Telegram file_id)."
        },
        "directUrl": {
          "type": "string",
          "description": "Direct download URL if available."
        },
        "isFavorite": {
          "type": "boolean"
        },
        "timestamp": {
          "type": "number",
          "description": "Creation epoch."
        },
        "provider": {
          "type": "string",
          "description": "The hosting provider used (e.g. Telegram)."
        }
      },
      "required": [
        "uid",
        "name",
        "timestamp"
      ]
    },
    "ImageToUrlHistory": {
      "title": "Image to URL History",
      "description": "Metadata for images hosted on external providers like ImgBB.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "thumb": {
          "type": "string"
        },
        "size": {
          "type": "number"
        },
        "mime": {
          "type": "string"
        },
        "timestamp": {
          "type": "number"
        },
        "isFavorite": {
          "type": "boolean"
        },
        "links": {
          "type": "object",
          "properties": {
            "direct": { "type": "string" },
            "view": { "type": "string" },
            "markdown": { "type": "string" },
            "html": { "type": "string" },
            "bbcode": { "type": "string" }
          }
        }
      },
      "required": [
        "uid",
        "url",
        "timestamp"
      ]
    }
  },
  "auth": {
    "providers": [
      "anonymous",
      "email"
    ]
  },
  "firestore": {
    "/p2p_signaling/{roomId}": {
      "schema": "#/entities/SignalingRoom",
      "description": "Active P2P signaling rooms."
    },
    "/p2p_signaling/{roomId}/callerCandidates/{id}": {
      "schema": "#/entities/IceCandidate",
      "description": "ICE candidates from the sender."
    },
    "/p2p_signaling/{roomId}/calleeCandidates/{id}": {
      "schema": "#/entities/IceCandidate",
      "description": "ICE candidates from the receiver."
    },
    "/temp_rooms/{code}": {
      "schema": "#/entities/TempRoom",
      "description": "Ephemeral pairing data for live clipboard sharing."
    },
    "/pages/{id}": {
      "schema": "#/entities/HostedPage",
      "description": "User generated static HTML pages and code blocks."
    },
    "/file_host_history/{docId}": {
      "schema": "#/entities/FileHostHistory",
      "description": "Secure archive of hosted file metadata."
    },
    "/image_to_url_history/{docId}": {
      "schema": "#/entities/ImageToUrlHistory",
      "description": "Secure archive of hosted image metadata."
    }
  }
}
