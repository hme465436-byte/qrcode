{
  "entities": {
    "ChatUser": {
      "title": "Chat User",
      "description": "User profile metadata for the chat system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "username_lowercase": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "about": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "object" }
      },
      "required": ["uid", "username"]
    },
    "FriendRequest": {
      "title": "Friend Request",
      "description": "Pending connection request between two users.",
      "type": "object",
      "properties": {
        "from": { "type": "string" },
        "fromName": { "type": "string" },
        "to": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "timestamp": { "type": "object" }
      }
    },
    "Chat": {
      "title": "Chat Session",
      "description": "A 1:1 chat session metadata.",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "senderId": { "type": "string" },
            "timestamp": { "type": "object" }
          }
        },
        "unreadCount": { "type": "object" }
      }
    },
    "Message": {
      "title": "Message",
      "description": "An individual chat message.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "imageUrl": { "type": "string" },
        "timestamp": { "type": "object" },
        "status": { "type": "string", "enum": ["sent", "seen"] }
      }
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/chat_users/{uid}": {
      "schema": "#/entities/ChatUser",
      "description": "User profiles for the chat system."
    },
    "/friend_requests/{requestId}": {
      "schema": "#/entities/FriendRequest",
      "description": "Inbound and outbound friend requests."
    },
    "/chats/{chatId}": {
      "schema": "#/entities/Chat",
      "description": "Active chat sessions."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "#/entities/Message",
      "description": "Real-time message stream for a chat."
    },
    "/ai_history/{uid}/messages/{messageId}": {
      "schema": "#/entities/Message",
      "description": "Persistent AI chat history for the user."
    }
  }
}
